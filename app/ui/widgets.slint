// Тема, иконки и базовые виджеты в стиле v2rayNG.

import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> primary: dark ? #1b2128 : #263238;
    out property <color> primary-text: #ffffff;
    out property <color> accent: #f97910;
    out property <color> fab-idle: dark ? #5f6368 : #9e9e9e;
    out property <color> bg: dark ? #121212 : #eceff1;
    out property <color> card: dark ? #1e1e1e : #ffffff;
    out property <color> card-pressed: dark ? #2a2a2a : #f2f2f2;
    out property <color> text: dark ? #e8eaed : #212121;
    out property <color> text2: dark ? #9aa0a6 : #757575;
    out property <color> divider: dark ? #2f3337 : #e0e0e0;
    out property <color> good: #43a047;
    out property <color> warn: #fb8c00;
    out property <color> bad: #e53935;
    out property <color> proxy: #1e88e5;
    out property <color> direct: #43a047;
    out property <color> block: #e53935;
}

// ───────────── иконки (собственные контуры 24×24) ─────────────

export component Icon inherits Path {
    in property <string> name;
    in property <color> color: Theme.primary-text;
    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 2px;
    fill: name == "more" ? color : transparent;
    commands: name == "menu" ? "M 4 7 L 20 7 M 4 12 L 20 12 M 4 17 L 20 17"
        : name == "plus" ? "M 12 5 L 12 19 M 5 12 L 19 12"
        : name == "back" ? "M 19 12 L 5 12 M 11 6 L 5 12 L 11 18"
        : name == "check" ? "M 5 12.5 L 10 17.5 L 19.5 7"
        : name == "close" ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : name == "share" ? "M 17.5 5.5 L 6.5 12 L 17.5 18.5 M 17.5 3.5 A 2 2 0 1 1 17.49 3.5 M 6.5 10 A 2 2 0 1 1 6.49 10 M 17.5 16.5 A 2 2 0 1 1 17.49 16.5"
        : name == "edit" ? "M 4 20 L 4 16 L 15 5 L 19 9 L 8 20 Z M 13 7 L 17 11"
        : name == "delete" ? "M 5 7 L 19 7 M 10 7 L 10 4.5 L 14 4.5 L 14 7 M 7 7 L 8 20 L 16 20 L 17 7 M 10.5 10.5 L 10.5 16.5 M 13.5 10.5 L 13.5 16.5"
        : name == "refresh" ? "M 19 12 A 7 7 0 1 1 16.5 6.6 M 17 3 L 17 7 L 13 7"
        : name == "speed" ? "M 4 16 A 8 8 0 1 1 20 16 M 12 16 L 16 10"
        : name == "sub" ? "M 5 5 L 19 5 L 19 19 L 5 19 Z M 8 9 L 16 9 M 8 12 L 16 12 M 8 15 L 13 15"
        : name == "route" ? "M 6 4 A 2 2 0 1 1 5.99 4 M 18 16 A 2 2 0 1 1 17.99 16 M 6 6 L 6 12 A 4 4 0 0 0 10 16 L 16 16"
        : name == "apps" ? "M 4 4 L 10 4 L 10 10 L 4 10 Z M 14 4 L 20 4 L 20 10 L 14 10 Z M 4 14 L 10 14 L 10 20 L 4 20 Z M 14 14 L 20 14 L 20 20 L 14 20 Z"
        : name == "settings" ? "M 12 9 A 3 3 0 1 1 11.99 9 M 12 2.5 L 12 5.5 M 12 18.5 L 12 21.5 M 2.5 12 L 5.5 12 M 18.5 12 L 21.5 12 M 5.3 5.3 L 7.4 7.4 M 16.6 16.6 L 18.7 18.7 M 5.3 18.7 L 7.4 16.6 M 16.6 7.4 L 18.7 5.3"
        : name == "log" ? "M 6 3 L 15 3 L 19 7 L 19 21 L 6 21 Z M 9 11 L 16 11 M 9 14 L 16 14 M 9 17 L 13 17"
        : name == "info" ? "M 12 3 A 9 9 0 1 1 11.99 3 M 12 11 L 12 17 M 12 7.5 L 12 8"
        : name == "copy" ? "M 8 8 L 20 8 L 20 20 L 8 20 Z M 16 8 L 16 4 L 4 4 L 4 16 L 8 16"
        : name == "download" ? "M 12 4 L 12 15 M 7 10 L 12 15 L 17 10 M 5 20 L 19 20"
        : name == "search" ? "M 10.5 4 A 6.5 6.5 0 1 1 10.49 4 M 15.5 15.5 L 20 20"
        : name == "sort" ? "M 4 6 L 20 6 M 4 12 L 14 12 M 4 18 L 9 18"
        : name == "more" ? "M 10.5 3.5 L 13.5 3.5 L 13.5 6.5 L 10.5 6.5 Z M 10.5 10.5 L 13.5 10.5 L 13.5 13.5 L 10.5 13.5 Z M 10.5 17.5 L 13.5 17.5 L 13.5 20.5 L 10.5 20.5 Z"
        : name == "up" ? "M 12 19 L 12 5 M 6 11 L 12 5 L 18 11"
        : "";
}

// Логотип для кнопки подключения: стилизованная «V».
export component Logo inherits Path {
    in property <color> color: white;
    width: 26px;
    height: 26px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 3px;
    fill: transparent;
    commands: "M 4 5 L 12 20 L 20 5";
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.primary-text;
    in property <bool> enabled: true;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: self.width / 2;
    background: ta.pressed ? #ffffff22 : transparent;
    opacity: enabled ? 1 : 0.4;
    Icon {
        name: root.icon;
        color: root.tint;
        stroke-width: root.icon == "more" ? 1px : 2px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TopBar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-back: true;
    callback back();
    callback menu();
    background: Theme.primary;
    height: 56px;
    drop-shadow-blur: 4px;
    drop-shadow-color: #00000040;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        alignment: stretch;
        IconButton {
            icon: root.show-back ? "back" : "menu";
            clicked => {
                if (root.show-back) { root.back(); } else { root.menu(); }
            }
        }
        VerticalLayout {
            alignment: center;
            padding-left: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.primary-text;
                font-size: 19px;
                font-weight: 600;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: #ffffffb0;
                font-size: 12px;
                overflow: elide;
            }
        }
        @children
    }
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 6px;
    drop-shadow-blur: 3px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: Theme.dark ? #00000060 : #0000001c;
}

export component SectionTitle inherits Text {
    color: Theme.accent;
    font-size: 13px;
    font-weight: 700;
}

export component Hint inherits Text {
    color: Theme.text2;
    font-size: 12px;
    wrap: word-wrap;
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 40px;
    min-width: label.preferred-width + 28px;
    background: transparent;
    label := Text {
        text: root.text;
        color: root.active ? #ffffff : #ffffffa0;
        font-size: 14px;
        font-weight: root.active ? 700 : 400;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        width: label.preferred-width + 12px;
        background: root.active ? Theme.accent : transparent;
        border-radius: 1.5px;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Пункт меню в выпадающем списке
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();
    height: 48px;
    background: ta.pressed ? Theme.card-pressed : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        spacing: 14px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                color: Theme.text2;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 15px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.proxy;
    height: 22px;
    width: t.preferred-width + 14px;
    border-radius: 11px;
    background: tint.with-alpha(0.15);
    t := Text {
        text: root.text;
        color: root.tint;
        font-size: 12px;
        font-weight: 700;
    }
}

// Кнопка-текст в стиле Material (для диалогов)
export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    callback clicked();
    height: 40px;
    min-width: t.preferred-width + 24px;
    border-radius: 4px;
    background: ta.pressed ? tint.with-alpha(0.12) : transparent;
    t := Text {
        text: root.text;
        color: root.tint;
        font-size: 14px;
        font-weight: 700;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 42px;
    min-width: t.preferred-width + 32px;
    border-radius: 21px;
    background: !enabled ? Theme.fab-idle : ta.pressed ? Theme.accent.darker(0.15) : Theme.accent;
    t := Text {
        text: root.text;
        color: white;
        font-size: 14px;
        font-weight: 700;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
