// Тема, иконки и базовые виджеты. Почти чёрный (или светлый) фон, один лаймовый акцент,
// плоские списки, шрифты Onest и JetBrains Mono (цифры, адреса, условия правил).

import { Palette } from "std-widgets.slint";
import "fonts/Onest-Regular.ttf";
import "fonts/Onest-Medium.ttf";
import "fonts/Onest-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <string> mono: "JetBrains Mono";

    out property <color> bg: dark ? #0c0d0f : #f4f5f1;
    out property <color> surface: dark ? #15171a : #ffffff;
    // плашки поверх карточек: счётчики, значки приложений
    out property <color> surface2: dark ? #1d2024 : #ecede8;
    out property <color> ink: dark ? #f2f3f0 : #101214;
    out property <color> on-ink: dark ? #0c0d0f : #f4f5f1;
    out property <color> ink2: dark ? #9499a1 : #5c6168;
    out property <color> ink3: dark ? #5d626a : #8a8f96;
    out property <color> line: dark ? #272b30 : #d5d8d0;
    out property <color> hair: dark ? #1d2024 : #e4e6df;
    out property <color> ring: dark ? #3a3f46 : #b4b8af;
    out property <color> knob-off: dark ? #9499a1 : #ffffff;
    out property <color> accent: dark ? #c2f24b : #447a00;
    out property <color> on-accent: dark ? #10140a : #ffffff;
    out property <color> warn: dark ? #f0b45a : #8a5200;
    out property <color> bad: dark ? #ff7a6b : #b42318;
    out property <color> scrim: dark ? #050607b8 : #10121466;
    out property <color> toast: dark ? #272b30 : #101214;
}

// ───────────── иконки (контуры 24×24, штрих 1.75) ─────────────

export component Icon inherits Path {
    in property <string> name;
    in property <color> color: Theme.ink;
    in property <length> size: 22px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 1.75px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: name == "logo" ? "M 4 4 L 20 20 M 20 4 L 4 20"
        : name == "gauge" ? "M 4 16 A 8 8 0 0 1 20 16 M 12 16 L 15.5 10"
        : name == "plus" ? "M 12 5 L 12 19 M 5 12 L 19 12"
        : name == "power" ? "M 12 3 L 12 11 M 6.3 6.8 A 8 8 0 1 0 17.7 6.8"
        : name == "globe" ? "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 M 3 12 L 21 12 M 12 3 C 8.5 7 8.5 17 12 21 M 12 3 C 15.5 7 15.5 17 12 21"
        : name == "route" ? "M 6 19 L 6 13 C 6 10 8 9 11 9 L 18 9 M 15 5.5 L 18.5 9 L 15 12.5 M 6 5 L 6 5.01"
        : name == "layers" ? "M 12 4 L 21 8.5 L 12 13 L 3 8.5 Z M 3 13 L 12 17.5 L 21 13"
        : name == "sliders" ? "M 4 7 L 12 7 M 18 7 L 20 7 M 4 17 L 6 17 M 12 17 L 20 17 M 15 4.5 A 2.5 2.5 0 1 0 15 9.5 A 2.5 2.5 0 1 0 15 4.5 M 9 14.5 A 2.5 2.5 0 1 0 9 19.5 A 2.5 2.5 0 1 0 9 14.5"
        : name == "chevron" ? "M 9 6 L 15 12 L 9 18"
        : name == "arrow" ? "M 5 12 L 19 12 M 13 6 L 19 12 L 13 18"
        : name == "back" ? "M 19 12 L 5 12 M 11 6 L 5 12 L 11 18"
        : name == "refresh" ? "M 20 12 A 8 8 0 1 1 17.5 6.2 M 20 4 L 20 8 L 16 8"
        : name == "edit" ? "M 4 20 L 8 20 L 19 9 L 15 5 L 4 16 Z M 13 7 L 17 11"
        : name == "search" ? "M 11 4 A 7 7 0 1 0 11 18 A 7 7 0 1 0 11 4 M 16 16 L 20 20"
        : name == "check" ? "M 5 12.5 L 10 17 L 19 7"
        : name == "delete" ? "M 5 7 L 19 7 M 10 7 L 10 4 L 14 4 L 14 7 M 7 7 L 8 20 L 16 20 L 17 7"
        : name == "share" ? "M 12 15 L 12 4 M 8 8 L 12 4 L 16 8 M 5 13 L 5 19 L 19 19 L 19 13"
        : name == "copy" ? "M 8 8 L 20 8 L 20 20 L 8 20 Z M 16 8 L 16 4 L 4 4 L 4 16 L 8 16"
        : name == "paste" ? "M 9 4 L 15 4 L 15 7 L 9 7 Z M 7 5.5 L 5 5.5 L 5 20 L 19 20 L 19 5.5 L 17 5.5 M 9 12 L 15 12 M 9 16 L 13 16"
        : name == "sort" ? "M 4 6 L 20 6 M 4 12 L 14 12 M 4 18 L 9 18"
        : name == "up" ? "M 12 19 L 12 5 M 6 11 L 12 5 L 18 11"
        : name == "down" ? "M 12 5 L 12 19 M 6 13 L 12 19 L 18 13"
        : "";
}

// ───────────── базовые элементы ─────────────

// Моноширинный текст: цифры, адреса, условия правил.
export component Mono inherits Text {
    font-family: Theme.mono;
}

// Кнопка-иконка 44×44 без фона.
export component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.ink;
    in property <length> icon-size: 22px;
    in property <bool> enabled: true;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: ta.pressed ? Theme.ink.with-alpha(0.08) : transparent;
    opacity: enabled ? 1 : 0.4;
    Icon {
        name: root.icon;
        size: root.icon-size;
        color: root.tint;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Заголовок экрана-вкладки: крупное название, действие справа.
export component PageHeader inherits Rectangle {
    in property <string> title;
    height: 76px;
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 20px;
        padding-top: 24px;
        padding-bottom: 8px;
        Text {
            text: root.title;
            color: Theme.ink;
            font-size: 28px;
            font-weight: 600;
            letter-spacing: -0.56px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        HorizontalLayout { @children }
    }
}

// Шапка вложенного экрана: «назад», заголовок, действие справа.
export component SubHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    callback back();
    height: 64px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 16px;
        padding-bottom: 4px;
        spacing: 4px;
        RoundButton { icon: "back"; clicked => { root.back(); } }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.ink;
                font-size: 17px;
                font-weight: 600;
                letter-spacing: -0.17px;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.ink2;
                font-size: 12px;
                overflow: elide;
            }
        }
        HorizontalLayout { spacing: 4px; @children }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 16px;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component SectionLabel inherits Text {
    color: Theme.ink2;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.96px;
}

export component Hint inherits Text {
    color: Theme.ink2;
    font-size: 12px;
    wrap: word-wrap;
}

export component Chevron inherits Icon {
    name: "chevron";
    size: 16px;
    color: Theme.ink2;
    stroke-width: 2px;
}

// Переключатель 40×24 в зоне нажатия 56×44.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 56px;
    height: 44px;
    Rectangle {
        width: 40px;
        height: 24px;
        border-radius: 12px;
        background: root.checked ? Theme.accent : Theme.line;
        animate background { duration: 150ms; }
        Rectangle {
            x: root.checked ? 19px : 3px;
            y: 3px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: root.checked ? Theme.on-accent : Theme.knob-off;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Радиокнопка: выбранная — толстое кольцо.
export component Radio inherits Rectangle {
    in property <bool> on;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: root.on ? 6px : 1.5px;
    border-color: root.on ? Theme.accent : Theme.ring;
}

// Флажок 22×22 со скруглением 7.
export component Check inherits Rectangle {
    in property <bool> on;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    border-width: root.on ? 0px : 1.5px;
    border-color: Theme.ring;
    background: root.on ? Theme.accent : transparent;
    if root.on: Icon {
        name: "check";
        size: 14px;
        color: Theme.on-accent;
        stroke-width: 3px;
    }
}

// Плитка приложения: нейтральная, с первой буквой названия.
export component AppTile inherits Rectangle {
    in property <string> letter;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: Theme.surface2;
    Text {
        text: root.letter;
        color: Theme.ink;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Плашка со значением: задержка, число серверов.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.ink2;
    in property <length> font-size: 12px;
    in property <length> pad-y: 4px;
    height: t.preferred-height + 2 * pad-y;
    width: t.preferred-width + 20px;
    border-radius: 10px;
    background: Theme.surface2;
    t := Mono {
        text: root.text;
        color: root.ink;
        font-size: root.font-size;
    }
}

// Чип группы серверов.
export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 44px;
    min-width: label.preferred-width + 32px;
    border-radius: 22px;
    background: active ? Theme.ink : transparent;
    border-width: active ? 0px : 1px;
    border-color: Theme.line;
    label := Text {
        text: root.text;
        color: root.active ? Theme.on-ink : Theme.ink2;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Основная кнопка: во всю ширину, заливка акцентом.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 56px;
    min-width: lay.preferred-width + 48px;
    border-radius: 16px;
    background: !enabled ? Theme.surface2 : Theme.accent;
    opacity: ta.pressed ? 0.85 : 1;
    lay := HorizontalLayout {
        alignment: center;
        spacing: 10px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; size: 18px; stroke-width: 2px; color: root.enabled ? Theme.on-accent : Theme.ink2; }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.on-accent : Theme.ink2;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Второстепенная кнопка: контур.
export component OutlineButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 56px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.line;
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    Text {
        text: root.text;
        color: Theme.ink;
        font-size: 15px;
        font-weight: 500;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Текстовая кнопка (диалоги, «Скачать»).
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.ink;
    in property <bool> enabled: true;
    callback clicked();
    height: 44px;
    min-width: t.preferred-width + 24px;
    border-radius: 12px;
    background: ta.pressed ? tint.with-alpha(0.08) : transparent;
    opacity: enabled ? 1 : 0.5;
    t := Text {
        text: root.text;
        color: root.tint;
        font-size: 14px;
        font-weight: 500;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Строка-ссылка с плюсом: «Новый маршрут», «Новое правило».
export component AddLink inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 48px;
    border-radius: 12px;
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        alignment: start;
        VerticalLayout { alignment: center; Icon { name: "plus"; size: 18px; stroke-width: 2px; color: Theme.accent; } }
        Text { text: root.text; color: Theme.accent; font-size: 14px; font-weight: 500; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Строка списка с нажатием.
export component Tappable inherits Rectangle {
    callback clicked();
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Выбор одного из вариантов в одну строку.
export component Segmented inherits Rectangle {
    in property <[string]> model;
    in property <int> current;
    callback selected(int);
    height: 52px;
    border-radius: 14px;
    background: Theme.surface;
    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for label[i] in root.model: Rectangle {
            horizontal-stretch: 1;
            border-radius: 10px;
            background: i == root.current ? Theme.ink : transparent;
            Text {
                text: label;
                color: i == root.current ? Theme.on-ink : Theme.ink2;
                font-size: 14px;
                font-weight: 500;
            }
            TouchArea { clicked => { root.selected(i); } }
        }
    }
}

// ───────────── поля ввода ─────────────

// Однострочное поле в контуре; подпись — над полем.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <InputType> input-type: InputType.text;
    in property <bool> mono: false;
    callback edited(string);
    spacing: 8px;
    if root.label != "": SectionLabel { text: root.label; }
    Rectangle {
        height: 52px;
        border-radius: 14px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.ring : Theme.line;
        input := TextInput {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            vertical-alignment: center;
            text: root.text;
            input-type: root.input-type;
            color: Theme.ink;
            font-size: root.mono ? 14px : 16px;
            font-weight: root.mono ? 400 : 500;
            font-family: root.mono ? Theme.mono : "";
            single-line: true;
            selection-background-color: Theme.accent.with-alpha(0.3);
            selection-foreground-color: Theme.ink;
            edited => {
                root.text = self.text;
                root.edited(self.text);
            }
        }
        if input.text == "" && root.placeholder != "": Text {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            vertical-alignment: center;
            text: root.placeholder;
            color: Theme.ink3;
            font-size: 15px;
            overflow: elide;
        }
    }
}

// Многострочное поле (моноширинное).
export component Area inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <length> area-height: 120px;
    callback edited(string);
    spacing: 8px;
    if root.label != "": SectionLabel { text: root.label; }
    Rectangle {
        height: root.area-height;
        border-radius: 14px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.ring : Theme.line;
        clip: true;
        input := TextInput {
            x: 16px;
            y: 14px;
            width: parent.width - 32px;
            height: parent.height - 28px;
            text: root.text;
            color: Theme.ink;
            font-size: 13px;
            font-family: Theme.mono;
            single-line: false;
            wrap: word-wrap;
            selection-background-color: Theme.accent.with-alpha(0.3);
            selection-foreground-color: Theme.ink;
            edited => {
                root.text = self.text;
                root.edited(self.text);
            }
        }
    }
}

// Строка-переключатель: название, пояснение, тумблер.
export component ToggleRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> mono-hint: false;
    in property <length> inset: 16px;
    in-out property <bool> checked;
    callback toggled(bool);
    height: max(56px, lay.preferred-height);
    lay := HorizontalLayout {
        padding-left: root.inset;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.text;
                color: Theme.ink;
                font-size: 15px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if root.hint != "": Hint {
                text: root.hint;
                font-family: root.mono-hint ? Theme.mono : "";
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked <=> root.checked;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

// ───────────── выбор из списка (через нижний лист) ─────────────

export global Picker {
    in-out property <bool> visible;
    in-out property <string> title;
    in-out property <[string]> items;
    in-out property <int> current;
    in-out property <string> owner;
    // растёт при каждом выборе
    in-out property <int> serial;
    in-out property <int> result;
}

// Строка «подпись + текущее значение + ›»; открывает лист выбора.
export component ChoiceRow inherits Rectangle {
    in property <string> label;
    in property <[string]> model;
    in property <int> current-index;
    in property <bool> mono-value: false;
    // true — подпись слева, значение справа (как «Если ничего не подошло»)
    in property <bool> inline: false;
    callback selected(int);
    property <int> serial: Picker.serial;
    property <string> value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    changed serial => {
        if (Picker.owner == root.label) {
            root.selected(Picker.result);
        }
    }
    height: max(inline ? 56px : 60px, lay.preferred-height);
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    lay := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        if !root.inline: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.label; color: Theme.ink2; font-size: 12px; }
            Text {
                text: root.value;
                color: Theme.ink;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
            }
        }
        if root.inline: Text {
            text: root.label;
            color: Theme.ink;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.inline: Text {
            text: root.value;
            color: Theme.ink;
            font-size: root.mono-value ? 13px : 14px;
            font-weight: 500;
            font-family: root.mono-value ? Theme.mono : "";
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Chevron { } }
    }
    ta := TouchArea {
        clicked => {
            Picker.title = root.label;
            Picker.items = root.model;
            Picker.current = root.current-index;
            Picker.owner = root.label;
            Picker.visible = true;
        }
    }
}

// Нижний лист: затемнение и контейнер.
export component SheetFrame inherits Rectangle {
    in property <string> title;
    callback dismiss();
    background: Theme.scrim;
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: sheet-lay.preferred-height;
        background: Theme.surface;
        border-top-left-radius: 28px;
        border-top-right-radius: 28px;
        TouchArea { }
        sheet-lay := VerticalLayout {
            padding: 12px;
            padding-bottom: 24px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.ring;
                }
            }
            if root.title != "": HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                height: 64px;
                Text {
                    text: root.title;
                    color: Theme.ink;
                    font-size: 20px;
                    font-weight: 600;
                    letter-spacing: -0.2px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            Flickable {
                height: min(body.preferred-height, root.height - 220px);
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: parent.width;
                    @children
                }
            }
        }
    }
}

// Пункт листа с иконкой.
export component SheetItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger: false;
    callback clicked();
    height: 56px;
    border-radius: 12px;
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; color: root.danger ? Theme.bad : Theme.ink2; }
        }
        Text {
            text: root.text;
            color: root.danger ? Theme.bad : Theme.ink;
            font-size: 15px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Разделитель между группами пунктов листа.
export component SheetDivider inherits Rectangle {
    height: 17px;
    Divider { x: 12px; width: parent.width - 24px; }
}

// Нижняя панель вкладок.
export component NavBar inherits Rectangle {
    in property <string> current;
    // высота системной полосы жестов: вкладки рисуются над ней
    in property <length> inset;
    callback open(string);
    height: 76px + root.inset;
    background: Theme.bg;
    // линия-разделитель — строго по верхнему краю (без y Slint центрирует элемент)
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;
        background: Theme.hair;
    }
    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: 76px;
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 8px;
        for tab in [
            { id: "main", icon: "globe", text: "Серверы" },
            { id: "routing", icon: "route", text: "Маршруты" },
            { id: "subs", icon: "layers", text: "Подписки" },
            { id: "settings", icon: "sliders", text: "Настройки" },
        ]: Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    Icon {
                        name: tab.icon;
                        color: root.current == tab.id ? Theme.accent : Theme.ink2;
                    }
                }
                Text {
                    text: tab.text;
                    color: root.current == tab.id ? Theme.ink : Theme.ink2;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                }
            }
            TouchArea { clicked => { root.open(tab.id); } }
        }
    }
}
