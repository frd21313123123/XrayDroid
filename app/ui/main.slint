// Главное окно XrayDroid. Четыре вкладки (серверы, маршруты, подписки, настройки)
// и вложенные экраны: редакторы сервера, правила и маршрута на отдельный сервер,
// приложения, дополнительные настройки, журнал, «о программе».

import { ScrollView } from "std-widgets.slint";
import {
    Theme, Icon, Mono, RoundButton, PageHeader, SubHeader, Card, Divider, SectionLabel, Hint, Chevron, Toggle, Radio,
    Check, AppTile, Badge, FilterChip, PrimaryButton, OutlineButton, TextButton, AddLink, Tappable, Segmented, Field,
    Area, ToggleRow, Picker, ChoiceRow, SheetFrame, SheetItem, SheetDivider, NavBar
} from "widgets.slint";

export { Theme, Picker }

export struct ServerItem {
    id: string,
    name: string,
    kind: string,
    delay: string,
    // 0 — нет, 1 — быстро, 2 — средне, 3 — медленно/ошибка, 4 — проверяется
    delay-state: int,
    selected: bool,
}

export struct SubItem {
    id: string,
    name: string,
    // группа без ссылки: серверы добавляются вручную, обновлять нечего
    local: bool,
    enabled: bool,
    count: string,
    has-usage: bool,
    ratio: float,
    warn: bool,
    used: string,
    limit: string,
    expire: string,
    updated: string,
}

export struct RuleItem {
    id: string,
    cond: string,
    outbound: int,
    enabled: bool,
}

export struct SplitItem {
    id: string,
    name: string,
    server: string,
    meta: string,
    enabled: bool,
}

export struct AppItem {
    pkg: string,
    label: string,
    checked: bool,
    letter: string,
}

export struct ProfileForm {
    id: string,
    protocol: int,
    remarks: string,
    address: string,
    port: string,
    uuid: string,
    username: string,
    method: string,
    method-index: int,
    flow: int,
    network: int,
    header-type: string,
    host: string,
    path: string,
    security: int,
    sni: string,
    alpn: string,
    fingerprint: string,
    allow-insecure: bool,
    pinned-cert: string,
    public-key: string,
    short-id: string,
    spider-x: string,
    obfs: int,
    obfs-password: string,
    secret: string,
    ports: string,
    udp-mode: int,
    congestion: int,
    local-address: string,
    reserved: string,
    wg-mtu: string,
}

export struct RuleForm {
    id: string,
    name: string,
    outbound: int,
    enabled: bool,
    domain: string,
    ip: string,
    port: string,
    network: int,
    protocol: string,
}

export struct SplitForm {
    id: string,
    name: string,
    server: string,
    domain: string,
    fallback-main: bool,
}

export struct SettingsForm {
    fake-dns: bool,
    sniffing: bool,
    ipv6: bool,
    local-socks: bool,
    socks-port: string,
    block-quic: bool,
    allow-insecure: bool,
    dns: string,
    mtu: string,
    test-url: string,
    ua: string,
    fragment: bool,
}

// ───────────── составные элементы ─────────────

// Вертикально прокручиваемая страница с отступами.
component Page inherits Rectangle {
    in property <length> side: 12px;
    in property <length> gap: 16px;
    in property <length> top-pad: 8px;
    in property <length> bottom-pad: 16px;
    // короткое содержимое не должно ограничивать высоту страницы
    max-height: 100000px;
    f := Flickable {
        content-height: lay.preferred-height;
        interactive: true;
        lay := VerticalLayout {
            width: f.width;
            padding-left: root.side;
            padding-right: root.side;
            padding-top: root.top-pad;
            padding-bottom: root.bottom-pad;
            spacing: root.gap;
            @children
        }
    }
}

// Кнопка «Сохранить» внизу редактора.
component SaveBar inherits Rectangle {
    callback clicked();
    height: 88px;
    PrimaryButton {
        x: 24px;
        y: 12px;
        width: parent.width - 48px;
        text: "Сохранить";
        clicked => { root.clicked(); }
    }
}

component ChoiceCard inherits Card {
    in property <string> label;
    in property <[string]> model;
    in property <int> current-index;
    callback selected(int);
    border-radius: 14px;
    clip: true;
    height: row.preferred-height;
    row := ChoiceRow {
        label: root.label;
        model: root.model;
        current-index: root.current-index;
        selected(i) => { root.selected(i); }
    }
}

component ToggleCard inherits Card {
    in property <string> text;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled(bool);
    border-radius: 14px;
    height: row.preferred-height + 8px;
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        row := ToggleRow {
            text: root.text;
            hint: root.hint;
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

// Заголовок раздела на вкладке: подпись слева, пояснение справа.
component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    in property <color> note-color: Theme.ink2;
    in property <length> side: 12px;
    in property <length> pad-top: 16px;
    in property <length> pad-bottom: 10px;
    padding-left: root.side;
    padding-right: root.side;
    padding-top: root.pad-top;
    padding-bottom: root.pad-bottom;
    SectionLabel { text: root.title; horizontal-stretch: 1; vertical-alignment: bottom; }
    Text { text: root.note; color: root.note-color; font-size: 12px; vertical-alignment: bottom; }
}

// Задержка сервера: быстрые — обычным цветом (у выбранного — акцентом), дальше жёлтым и красным.
component DelayText inherits Mono {
    in property <ServerItem> item;
    text: item.delay;
    font-size: 13px;
    vertical-alignment: center;
    color: item.delay-state == 1 ? (item.selected ? Theme.accent : Theme.ink)
        : item.delay-state == 2 ? Theme.warn
        : item.delay-state == 3 ? Theme.bad
        : Theme.ink2;
}

// Название сервера и строка протокола под ним.
component ServerText inherits VerticalLayout {
    in property <ServerItem> item;
    alignment: center;
    horizontal-stretch: 1;
    spacing: 4px;
    Text { text: root.item.name; color: Theme.ink; font-size: 15px; font-weight: 500; overflow: elide; }
    Text { text: root.item.kind; color: Theme.ink2; font-size: 12px; overflow: elide; }
}

// Строка сервера: точка выбора, название, протокол, задержка. Долгое нажатие — меню.
component ServerRow inherits Rectangle {
    in property <ServerItem> item;
    callback select();
    callback menu();
    property <bool> fired;
    height: 68px;
    border-radius: 16px;
    background: root.item.selected ? Theme.surface : ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    Timer {
        interval: 450ms;
        running: ta.pressed && !root.fired;
        triggered => {
            root.fired = true;
            root.menu();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.item.selected ? Theme.accent : transparent;
                border-width: root.item.selected ? 0px : 1px;
                border-color: Theme.ring;
            }
        }
        ServerText { item: root.item; }
        DelayText { item: root.item; }
    }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.fired = false;
            }
        }
        clicked => {
            if (!root.fired) {
                root.select();
            }
        }
    }
}

// Выбор сервера в листе редактора маршрута.
component ServerPick inherits Rectangle {
    in property <ServerItem> item;
    callback pick();
    height: 60px;
    border-radius: 12px;
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout { alignment: center; Radio { on: root.item.selected; } }
        ServerText { item: root.item; }
        DelayText { item: root.item; }
    }
    ta := TouchArea { clicked => { root.pick(); } }
}

// Строка выбора приложения (флажок справа).
component AppPick inherits Rectangle {
    in property <AppItem> item;
    callback toggle(bool);
    height: 52px;
    border-radius: 12px;
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout { alignment: center; AppTile { letter: root.item.letter; } }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.item.label; color: Theme.ink; font-size: 15px; font-weight: 500; overflow: elide; }
            Mono { text: root.item.pkg; color: Theme.ink2; font-size: 11px; overflow: elide; }
        }
        VerticalLayout { alignment: center; Check { on: root.item.checked; } }
    }
    ta := TouchArea { clicked => { root.toggle(!root.item.checked); } }
}

// Поле поиска приложения.
component SearchBox inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    height: 48px;
    border-radius: 14px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout { alignment: center; Icon { name: "search"; size: 18px; color: Theme.ink2; } }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                text: root.text;
                color: Theme.ink;
                font-size: 15px;
                single-line: true;
                selection-background-color: Theme.accent.with-alpha(0.3);
                selection-foreground-color: Theme.ink;
                edited => {
                    root.text = self.text;
                    root.edited(self.text);
                }
            }
            if input.text == "": Text {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                text: "Поиск приложения";
                color: Theme.ink2;
                font-size: 15px;
            }
        }
    }
}

component DialogFrame inherits Rectangle {
    in property <string> title;
    callback dismiss();
    background: Theme.scrim;
    TouchArea { clicked => { root.dismiss(); } }
    Card {
        x: 20px;
        width: parent.width - 40px;
        y: max(24px, (parent.height - self.height) / 3);
        height: lay.preferred-height;
        border-radius: 24px;
        TouchArea { }
        lay := VerticalLayout {
            padding: 20px;
            padding-bottom: 12px;
            spacing: 14px;
            Text {
                text: root.title;
                color: Theme.ink;
                font-size: 18px;
                font-weight: 600;
                letter-spacing: -0.18px;
                wrap: word-wrap;
            }
            @children
        }
    }
}

component NavLink inherits Rectangle {
    in property <string> text;
    in property <string> value;
    in property <bool> mono-value: false;
    callback clicked();
    height: 52px;
    background: ta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Text { text: root.text; color: Theme.ink; font-size: 15px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
        Text {
            text: root.value;
            color: Theme.ink2;
            font-size: 12px;
            font-family: root.mono-value ? Theme.mono : "";
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Chevron { } }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Плоская строка настройки с тумблером и линией снизу.
component SettingRow inherits Rectangle {
    in property <string> text;
    in property <bool> last: false;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 56px;
    ToggleRow {
        inset: 12px;
        text: root.text;
        checked <=> root.checked;
        toggled(v) => { root.toggled(v); }
    }
    if !root.last: Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hair;
    }
}

// Скорость в одну сторону: стрелка и значение.
component Speed inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    spacing: 8px;
    VerticalLayout { alignment: center; Icon { name: root.icon; size: 14px; stroke-width: 2px; color: Theme.ink2; } }
    Mono { text: root.text; color: Theme.ink; font-size: 13px; vertical-alignment: center; }
}

// ───────────── окно ─────────────

export component MainWindow inherits Window {
    title: "XrayDroid";
    background: Theme.bg;
    preferred-width: 390px;
    preferred-height: 844px;
    default-font-family: "Onest";
    default-font-size: 14px;

    // ── навигация ──
    in-out property <string> page: "main";
    in property <string> version;

    // ── обновление приложения ──
    // 0 — нет данных, 1 — проверка, 2 — доступно, 3 — загрузка, 4 — установка, 5 — ошибка, 6 — последняя версия
    in property <int> update-state;
    in property <string> update-version;
    in property <string> update-current;
    in property <int> update-progress;
    in property <string> update-message;
    in-out property <bool> update-dialog;

    // ── главный экран ──
    in property <[ServerItem]> servers;
    in property <[string]> groups;
    in-out property <int> current-group;
    in property <bool> running;
    in property <bool> connecting;
    in property <string> status-title: "Не подключено";
    // пояснение под кнопкой: текст ошибки или «Подождите»
    in property <string> status-sub;
    in property <bool> status-error;
    // время с момента подключения
    in property <string> timer-text: "00:00:00";
    in property <string> down-value: "0";
    in property <string> down-unit: "КБ/с";
    in property <string> up-value: "0";
    in property <string> up-unit: "КБ/с";
    in property <string> selected-name;

    // ── листы, диалоги, уведомление ──
    in-out property <string> sheet;
    // сервер, для которого открыт лист действий
    in-out property <ServerItem> sheet-server;
    in property <string> toast-text;
    in property <bool> toast-visible;
    in-out property <bool> confirm-visible;
    in-out property <string> confirm-text;
    in-out property <string> confirm-action;
    in-out property <bool> paste-visible;
    in-out property <string> paste-text;

    // ── редактор сервера ──
    in-out property <ProfileForm> form;
    in-out property <bool> form-is-new;

    // ── подписки ──
    in property <[SubItem]> subs;
    in property <bool> subs-busy;
    in-out property <bool> sub-auto: true;
    in-out property <bool> sub-dialog;
    // диалог открыт для группы без ссылки (поле URL скрыто)
    in-out property <bool> sub-group;
    in-out property <string> sub-id;
    in-out property <string> sub-name;
    in-out property <string> sub-url;

    // ── маршруты ──
    in property <[string]> presets;
    in property <int> preset-index;
    in-out property <int> strategy-index;
    in-out property <int> final-index;
    in property <[RuleItem]> rules;
    in property <[SplitItem]> splits;
    in property <string> geo-status;
    in property <bool> geo-busy;
    in-out property <RuleForm> rule-form;
    in-out property <bool> rule-is-new;

    // ── маршрут на отдельный сервер ──
    in-out property <SplitForm> split-form;
    in-out property <bool> split-is-new;
    in property <[ServerItem]> split-servers;
    // выбранный сервер маршрута (пустой id — не выбран)
    in property <ServerItem> split-server;
    in property <[AppItem]> split-apps;
    in property <int> split-apps-count;
    in property <string> split-apps-more;
    in-out property <string> split-filter;

    // ── настройки ──
    in-out property <SettingsForm> settings;
    in property <string> apps-summary: "все";

    // ── приложения (раздельное туннелирование VPN) ──
    in property <[AppItem]> apps;
    in property <bool> apps-loading;
    in-out property <int> apps-mode;
    in-out property <string> apps-filter;
    in property <string> apps-more;

    // ── журнал ──
    in property <[string]> logs;

    callback toggle-vpn();
    callback test-all();
    callback test-server(string);
    callback select-server(string);
    // выбрать сервер и подключиться к нему
    callback connect-server(string);
    callback edit-server(string);
    callback share-server(string);
    callback add-manual(int);
    callback import-clipboard();
    callback import-text(string);
    callback menu-action(string);
    callback group-changed(int);
    callback open-page(string);
    callback confirm-ok(string);
    callback form-save();
    callback form-protocol-changed(int);

    callback sub-save();
    callback sub-edit(string);
    callback sub-refresh(string);
    callback sub-new();
    // новая группа без ссылки (вкладка без импорта подписки)
    callback group-new();
    callback subs-update();
    callback sub-auto-changed(bool);

    callback routing-changed();
    callback rule-open(string);
    callback rule-toggle(string, bool);
    callback rule-save();
    callback rule-move(string, int);
    callback geo-download();

    callback split-open(string);
    callback split-toggle(string, bool);
    callback split-save();
    callback split-pick-server(string);
    callback split-app-toggle(string, bool);
    callback split-filter-changed(string);

    callback settings-save();
    callback update-check();
    callback update-start();
    callback apps-mode-changed(int);
    callback apps-filter-changed(string);
    callback app-toggle(string, bool);
    callback apps-select-all(bool);
    callback logs-refresh();
    callback logs-clear();
    callback logs-copy();

    public function focus-keys() {
        keys.focus();
    }

    function is-tab() -> bool {
        root.page == "main" || root.page == "routing" || root.page == "subs" || root.page == "settings"
    }

    function go-back() {
        if (root.sheet != "") {
            root.sheet = "";
        } else if (root.page == "rule" || root.page == "split") {
            root.open-page("routing");
        } else if (root.page == "apps" || root.page == "advanced" || root.page == "logs" || root.page == "about") {
            root.open-page("settings");
        } else if (root.page != "main") {
            root.open-page("main");
        }
    }

    function show-tab(id: string) {
        if (root.page == "settings") {
            root.settings-save();
        }
        root.open-page(id);
    }

    property <length> kb: self.virtual-keyboard-size.height;
    property <length> bottom-inset: root.safe-area-insets.bottom;

    // выбор из листа, открытого не строкой ChoiceRow: тип нового сервера, готовый набор правил
    property <int> pick-serial: Picker.serial;
    changed pick-serial => {
        if (Picker.owner == "new-server") {
            root.add-manual(Picker.result);
        } else if (Picker.owner == "preset") {
            root.confirm-text = "Заменить текущие правила набором «" + root.presets[Picker.result] + "»?";
            root.confirm-action = "apply-preset:" + Picker.result;
            root.confirm-visible = true;
        }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Back || e.text == Key.Escape) {
                if (Picker.visible) { Picker.visible = false; return accept; }
                if (root.confirm-visible) { root.confirm-visible = false; return accept; }
                if (root.update-dialog) { root.update-dialog = false; return accept; }
                if (root.paste-visible) { root.paste-visible = false; return accept; }
                if (root.sub-dialog) { root.sub-dialog = false; return accept; }
                if (root.page == "main" && root.sheet == "") {
                    return reject;
                }
                root.go-back();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-top: root.safe-area-insets.top;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            padding-bottom: root.is-tab() ? 0px : max(root.bottom-inset, root.kb);

            // ═══════════════ СЕРВЕРЫ ═══════════════
            if root.page == "main": VerticalLayout {
                vertical-stretch: 1;
                // шапка
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 20px;
                        padding-top: 20px;
                        HorizontalLayout {
                            spacing: 10px;
                            horizontal-stretch: 1;
                            VerticalLayout { alignment: center; Icon { name: "logo"; size: 20px; stroke-width: 2.5px; color: Theme.accent; } }
                            Text {
                                text: "XrayDroid";
                                color: Theme.ink;
                                font-size: 17px;
                                font-weight: 600;
                                letter-spacing: -0.17px;
                                vertical-alignment: center;
                            }
                        }
                        RoundButton { icon: "plus"; clicked => { root.sheet = "add"; } }
                    }
                }
                // статус, таймер, кнопка подключения
                VerticalLayout {
                    vertical-stretch: 0;
                    alignment: start;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 24px;
                    spacing: 22px;
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    property <bool> on: root.running && !root.connecting && !root.status-error;
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: self.on ? Theme.accent : transparent;
                                    border-width: self.on ? 0px : 1px;
                                    border-color: root.status-error ? Theme.bad : Theme.ink2;
                                }
                            }
                            Text {
                                text: root.status-title;
                                color: root.status-error ? Theme.bad : root.running && !root.connecting ? Theme.accent : Theme.ink2;
                                font-size: 13px;
                                font-weight: 500;
                                letter-spacing: 0.26px;
                                vertical-alignment: center;
                            }
                        }
                        Mono {
                            text: root.timer-text;
                            color: root.running && !root.connecting ? Theme.ink : Theme.ink3;
                            font-size: 44px;
                            letter-spacing: -1.3px;
                            horizontal-alignment: center;
                            height: 48px;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 132px;
                            height: 132px;
                            border-radius: 66px;
                            border-width: 1px;
                            border-color: root.running ? Theme.accent : Theme.line;
                            animate border-color { duration: 250ms; }
                            Rectangle {
                                width: 114px;
                                height: 114px;
                                border-radius: 57px;
                                background: root.running ? Theme.accent : Theme.ink;
                                opacity: root.connecting ? 0.6 : power.pressed ? 0.85 : 1;
                                animate background { duration: 250ms; }
                                Icon {
                                    name: "power";
                                    size: 40px;
                                    color: root.running ? Theme.on-accent : Theme.on-ink;
                                }
                            }
                            power := TouchArea { clicked => { root.toggle-vpn(); } }
                        }
                    }
                    // под кнопкой: скорость, ошибка или сервер, к которому подключимся
                    VerticalLayout {
                        min-height: 16px;
                        if root.status-sub != "": Text {
                            text: root.status-sub;
                            color: root.status-error ? Theme.bad : Theme.ink2;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        if root.status-sub == "" && root.running: HorizontalLayout {
                            alignment: center;
                            spacing: 28px;
                            height: 16px;
                            Speed { icon: "down"; text: root.down-value + " " + root.down-unit; }
                            VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: Theme.line; } }
                            Speed { icon: "up"; text: root.up-value + " " + root.up-unit; }
                        }
                        if root.status-sub == "" && !root.running: HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            height: 16px;
                            Text {
                                text: root.selected-name != "" ? "Подключится к" : "Выберите или добавьте сервер";
                                color: Theme.ink2;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            if root.selected-name != "": Text {
                                text: root.selected-name;
                                color: Theme.ink;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 230px;
                            }
                        }
                    }
                }
                // группы и проверка задержки
                HorizontalLayout {
                    vertical-stretch: 0;
                    height: 52px;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Flickable {
                        horizontal-stretch: 1;
                        content-width: chips.preferred-width;
                        chips := HorizontalLayout {
                            spacing: 8px;
                            for g[i] in root.groups: FilterChip {
                                text: g;
                                active: i == root.current-group;
                                clicked => {
                                    root.current-group = i;
                                    root.group-changed(i);
                                }
                            }
                        }
                    }
                    RoundButton { icon: "gauge"; icon-size: 20px; tint: Theme.ink2; clicked => { root.test-all(); } }
                }
                // список серверов
                Rectangle {
                    vertical-stretch: 1;
                    preferred-height: 0px;
                    min-height: 96px;
                    clip: true;
                    if root.servers.length == 0: VerticalLayout {
                        alignment: center;
                        padding: 28px;
                        spacing: 12px;
                        Text {
                            text: root.current-group > 0 ? "В группе пока нет серверов" : "Серверов пока нет";
                            color: Theme.ink;
                            font-size: 17px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Hint {
                            text: root.current-group > 0
                                ? "Скопируйте ссылки на серверы и нажмите «Импорт» или создайте сервер через «+» — они попадут в эту группу."
                                : "Скопируйте ссылку на сервер (vless://, vmess://, trojan://, ss://…) или на подписку (https://…) и нажмите «Импорт».";
                            horizontal-alignment: center;
                        }
                        Rectangle { height: 4px; }
                        PrimaryButton {
                            text: "Импорт из буфера обмена";
                            clicked => { root.import-clipboard(); }
                        }
                    }
                    if root.servers.length > 0: Flickable {
                        content-height: srv.preferred-height;
                        srv := VerticalLayout {
                            width: parent.width;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-bottom: 8px;
                            for s in root.servers: ServerRow {
                                item: s;
                                select => { root.select-server(s.id); }
                                menu => {
                                    root.sheet-server = s;
                                    root.sheet = "server";
                                }
                            }
                        }
                    }
                }
            }

            // ═══════════════ МАРШРУТЫ ═══════════════
            if root.page == "routing": VerticalLayout {
                vertical-stretch: 1;
                PageHeader {
                    title: "Маршруты";
                    // готовые наборы правил
                    RoundButton {
                        icon: "layers";
                        clicked => {
                            Picker.title = "Набор правил";
                            Picker.items = root.presets;
                            Picker.current = root.preset-index;
                            Picker.owner = "preset";
                            Picker.visible = true;
                        }
                    }
                }
                Page {
                    vertical-stretch: 1;
                    gap: 0px;
                    top-pad: 0px;
                    SectionHead { title: "ОТДЕЛЬНЫЕ СЕРВЕРЫ"; note: root.splits.length > 0 ? "важнее правил ниже" : ""; }
                    VerticalLayout {
                        spacing: 8px;
                        for s in root.splits: Card {
                            height: max(68px, row.preferred-height);
                            clip: true;
                            Tappable {
                                x: 0px;
                                width: parent.width - 60px;
                                clicked => { root.split-open(s.id); }
                            }
                            row := HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 4px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text {
                                        text: s.name;
                                        color: s.enabled ? Theme.ink : Theme.ink2;
                                        font-size: 15px;
                                        font-weight: 500;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: s.meta; color: Theme.ink2; font-size: 12px; vertical-alignment: center; }
                                        VerticalLayout { alignment: center; Icon { name: "arrow"; size: 12px; color: Theme.ink2; stroke-width: 2px; } }
                                        Text {
                                            text: s.server;
                                            color: s.enabled ? Theme.ink : Theme.ink2;
                                            font-size: 12px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        checked: s.enabled;
                                        toggled(v) => { root.split-toggle(s.id, v); }
                                    }
                                }
                            }
                        }
                    }
                    AddLink { text: "Новый маршрут"; clicked => { root.split-open(""); } }

                    SectionHead { title: "ПРАВИЛА"; note: "сверху вниз, первое совпадение"; }
                    for r[i] in root.rules: Rectangle {
                        height: 56px;
                        Tappable {
                            x: 0px;
                            width: parent.width - 56px;
                            border-radius: 12px;
                            clicked => { root.rule-open(r.id); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 12px;
                            Mono { text: i + 1; color: Theme.ink2; font-size: 12px; min-width: 14px; vertical-alignment: center; }
                            Mono {
                                text: r.cond;
                                color: r.enabled ? Theme.ink : Theme.ink2;
                                font-size: 13px;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.outbound == 0 ? "Прокси" : r.outbound == 1 ? "Напрямую" : "Блок";
                                color: !r.enabled ? Theme.ink2 : r.outbound == 0 ? Theme.accent : r.outbound == 1 ? Theme.ink2 : Theme.bad;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: r.enabled;
                                    toggled(v) => { root.rule-toggle(r.id, v); }
                                }
                            }
                        }
                        if i < root.rules.length - 1: Rectangle {
                            x: 0px;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Theme.hair;
                        }
                    }
                    AddLink { text: "Новое правило"; clicked => { root.rule-open(""); } }

                    Rectangle { height: 8px; }
                    Card {
                        clip: true;
                        height: fc.preferred-height;
                        fc := VerticalLayout {
                            ChoiceRow {
                                label: "Если ничего не подошло";
                                inline: true;
                                model: ["Основной сервер", "Напрямую", "Блок"];
                                current-index: root.final-index;
                                selected(i) => { root.final-index = i; root.routing-changed(); }
                            }
                            Rectangle {
                                height: 1px;
                                Divider { x: 16px; width: parent.width - 32px; }
                            }
                            ChoiceRow {
                                label: "Стратегия DNS";
                                inline: true;
                                mono-value: true;
                                model: ["AsIs", "IPIfNonMatch", "IPOnDemand"];
                                current-index: root.strategy-index;
                                selected(i) => { root.strategy-index = i; root.routing-changed(); }
                            }
                            Rectangle {
                                height: 1px;
                                Divider { x: 16px; width: parent.width - 32px; }
                            }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 4px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 12px;
                                min-height: 56px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "Файлы geoip / geosite"; color: Theme.ink; font-size: 14px; }
                                    if root.geo-status != "": Hint { text: root.geo-status; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    TextButton {
                                        text: root.geo-busy ? "Загрузка…" : "Скачать";
                                        tint: Theme.accent;
                                        enabled: !root.geo-busy;
                                        clicked => { root.geo-download(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ═══════════════ ПОДПИСКИ ═══════════════
            if root.page == "subs": VerticalLayout {
                vertical-stretch: 1;
                PageHeader {
                    title: "Подписки";
                    RoundButton { icon: "refresh"; enabled: !root.subs-busy; clicked => { root.subs-update(); } }
                }
                Page {
                    vertical-stretch: 1;
                    gap: 12px;
                    top-pad: 16px;
                    for s in root.subs: Card {
                        border-radius: 20px;
                        height: sc.preferred-height;
                        opacity: s.enabled ? 1 : 0.6;
                        sc := VerticalLayout {
                            // подписка: название, расход трафика, обновление
                            if !s.local: VerticalLayout {
                                padding-left: 20px;
                                padding-right: 8px;
                                padding-top: 20px;
                                padding-bottom: 8px;
                                spacing: 18px;
                                HorizontalLayout {
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Text {
                                        text: s.name;
                                        color: Theme.ink;
                                        font-size: 17px;
                                        font-weight: 600;
                                        letter-spacing: -0.17px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    VerticalLayout { alignment: center; Badge { text: s.count; } }
                                }
                                if s.has-usage: VerticalLayout {
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: Theme.line;
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * s.ratio;
                                            height: 4px;
                                            border-radius: 2px;
                                            background: s.warn ? Theme.warn : Theme.accent;
                                        }
                                    }
                                    HorizontalLayout {
                                        Mono { text: s.used; color: Theme.ink; font-size: 12px; }
                                        Mono { text: s.limit; color: Theme.ink2; font-size: 12px; horizontal-stretch: 1; }
                                        Mono { text: s.expire; color: Theme.ink2; font-size: 12px; }
                                    }
                                }
                                HorizontalLayout {
                                    Text {
                                        text: s.updated;
                                        color: Theme.ink2;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    RoundButton { icon: "refresh"; icon-size: 20px; enabled: !root.subs-busy; clicked => { root.sub-refresh(s.id); } }
                                    RoundButton { icon: "edit"; icon-size: 20px; clicked => { root.sub-edit(s.id); } }
                                }
                            }
                            // группа без ссылки: одна строка
                            if s.local: HorizontalLayout {
                                // пояснение занимает две строки
                                min-height: 84px;
                                padding-left: 20px;
                                padding-right: 8px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: s.name;
                                        color: Theme.ink;
                                        font-size: 17px;
                                        font-weight: 600;
                                        letter-spacing: -0.17px;
                                        overflow: elide;
                                    }
                                    Hint { text: s.updated; }
                                }
                                VerticalLayout { alignment: center; Badge { text: s.count; } }
                                VerticalLayout {
                                    alignment: center;
                                    RoundButton { icon: "edit"; icon-size: 20px; clicked => { root.sub-edit(s.id); } }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        padding-top: root.subs.length > 0 ? 8px : 0px;
                        spacing: 8px;
                        PrimaryButton { text: "Добавить подписку"; icon: "plus"; clicked => { root.sub-new(); } }
                        OutlineButton { text: "Создать пустую группу"; clicked => { root.group-new(); } }
                    }
                    if root.subs.length == 0: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Hint { text: "Серверы подписки появятся отдельной вкладкой на главном экране. Пустая группа — вкладка без загрузки подписки: откройте её и добавляйте серверы через «+»."; }
                    }
                }
                // автообновление — всегда внизу, над панелью вкладок
                Rectangle {
                    height: 68px;
                    ToggleRow {
                        x: 12px;
                        width: parent.width - 24px;
                        inset: 12px;
                        text: "Автообновление";
                        hint: root.subs-busy ? "Обновление подписок…" : "Раз в сутки";
                        checked <=> root.sub-auto;
                        toggled(v) => { root.sub-auto-changed(v); }
                    }
                }
            }

            // ═══════════════ НАСТРОЙКИ ═══════════════
            if root.page == "settings": VerticalLayout {
                vertical-stretch: 1;
                PageHeader { title: "Настройки"; }
                Page {
                    vertical-stretch: 1;
                    gap: 0px;
                    top-pad: 0px;
                    SectionHead { title: "ОБНОВЛЕНИЕ"; note: root.update-current; pad-top: 8px; }
                    Card {
                        height: up.preferred-height;
                        up := VerticalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text {
                                        text: root.update-state == 1 ? "Проверка обновлений…"
                                            : root.update-state == 2 ? "Доступна версия " + root.update-version
                                            : root.update-state == 3 ? "Загрузка обновления"
                                            : root.update-state == 4 ? "Установка обновления…"
                                            : root.update-state == 5 ? "Не удалось обновить"
                                            : root.update-state == 6 ? "Установлена последняя версия"
                                            : "Обновления с GitHub";
                                        color: root.update-state == 5 ? Theme.bad : Theme.ink;
                                        font-size: 15px;
                                        font-weight: 500;
                                        wrap: word-wrap;
                                    }
                                    Hint {
                                        text: root.update-state == 2 ? "Скачается и установится само, VPN вернётся после перезапуска"
                                            : root.update-state == 3 ? "Версия " + root.update-version
                                            : root.update-state == 4 ? "Приложение перезапустится само"
                                            : root.update-state == 5 ? root.update-message
                                            : "Проверяются при запуске приложения";
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if root.update-state == 3: Mono {
                                        text: root.update-progress + "%";
                                        color: Theme.accent;
                                        font-size: 15px;
                                        width: 56px;
                                        horizontal-alignment: right;
                                    }
                                    if root.update-state == 3 || root.update-state == 4: Rectangle { width: 8px; }
                                    if root.update-state != 3 && root.update-state != 4: TextButton {
                                        text: root.update-state == 2 ? "Обновить" : "Проверить";
                                        tint: Theme.accent;
                                        enabled: root.update-state != 1;
                                        clicked => {
                                            if (root.update-state == 2) {
                                                root.update-start();
                                            } else {
                                                root.update-check();
                                            }
                                        }
                                    }
                                }
                            }
                            if root.update-state == 3 || root.update-state == 4: HorizontalLayout {
                                padding-right: 8px;
                                padding-bottom: 4px;
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.surface2;
                                    Rectangle {
                                        x: 0px;
                                        width: parent.width * (root.update-state == 4 ? 100 : root.update-progress) / 100;
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                        animate width { duration: 200ms; }
                                    }
                                }
                            }
                        }
                    }
                    SectionHead { title: "DNS И ТРАФИК"; pad-top: 20px; pad-bottom: 6px; }
                    SettingRow {
                        text: "FakeDNS";
                        checked: root.settings.fake-dns;
                        toggled(v) => { root.settings.fake-dns = v; root.settings-save(); }
                    }
                    SettingRow {
                        text: "Сниффинг";
                        checked: root.settings.sniffing;
                        toggled(v) => { root.settings.sniffing = v; root.settings-save(); }
                    }
                    SettingRow {
                        text: "IPv6 через VPN";
                        checked: root.settings.ipv6;
                        toggled(v) => { root.settings.ipv6 = v; root.settings-save(); }
                    }
                    SettingRow {
                        text: "Фрагментация TLS (обход DPI)";
                        checked: root.settings.fragment;
                        toggled(v) => { root.settings.fragment = v; root.settings-save(); }
                    }
                    SettingRow {
                        text: "Блокировать QUIC";
                        last: true;
                        checked: root.settings.block-quic;
                        toggled(v) => { root.settings.block-quic = v; root.settings-save(); }
                    }
                    SectionHead { title: "ЛОКАЛЬНЫЙ ПРОКСИ"; pad-top: 20px; pad-bottom: 6px; }
                    ToggleRow {
                        height: 64px;
                        inset: 12px;
                        text: "SOCKS5";
                        hint: "127.0.0.1:" + root.settings.socks-port;
                        mono-hint: true;
                        checked: root.settings.local-socks;
                        toggled(v) => { root.settings.local-socks = v; root.settings-save(); }
                    }
                    Rectangle { height: 16px; }
                    Card {
                        border-radius: 20px;
                        clip: true;
                        height: nl.preferred-height;
                        nl := VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            NavLink { text: "Прокси для приложений"; value: root.apps-summary; clicked => { root.settings-save(); root.open-page("apps"); } }
                            NavLink { text: "Дополнительно"; clicked => { root.settings-save(); root.open-page("advanced"); } }
                            NavLink { text: "Журнал"; clicked => { root.open-page("logs"); } }
                            NavLink { text: "О программе"; value: root.version; mono-value: true; clicked => { root.open-page("about"); } }
                        }
                    }
                }
            }

            // ═══════════════ РЕДАКТОР СЕРВЕРА ═══════════════
            if root.page == "edit": VerticalLayout {
                vertical-stretch: 1;
                SubHeader {
                    title: root.form-is-new ? "Новый сервер" : "Сервер";
                    subtitle: ["VLESS", "VMess", "Trojan", "Shadowsocks", "SOCKS", "Hysteria2", "TUIC", "AnyTLS", "HTTP", "NaiveProxy", "WireGuard"][root.form.protocol];
                    back => { root.open-page("main"); }
                }
                Page {
                    vertical-stretch: 1;
                    side: 24px;
                    gap: 18px;
                    top-pad: 12px;
                    SectionLabel { text: "ОСНОВНОЕ"; }
                    ChoiceCard {
                        label: "Протокол";
                        model: ["VLESS", "VMess", "Trojan", "Shadowsocks", "SOCKS", "Hysteria2", "TUIC", "AnyTLS", "HTTP", "NaiveProxy", "WireGuard"];
                        current-index: root.form.protocol;
                        selected(i) => { root.form.protocol = i; root.form-protocol-changed(i); }
                    }
                    Field { label: "НАЗВАНИЕ"; text: root.form.remarks; edited(t) => { root.form.remarks = t; } }
                    Field { label: "АДРЕС"; placeholder: "example.com или IP"; text: root.form.address; edited(t) => { root.form.address = t; } }
                    Field { label: "ПОРТ"; input-type: InputType.number; text: root.form.port; edited(t) => { root.form.port = t; } }
                    if root.form.protocol <= 1 || root.form.protocol == 6: Field {
                        label: "UUID (ID)";
                        mono: true;
                        text: root.form.uuid;
                        edited(t) => { root.form.uuid = t; }
                    }
                    if root.form.protocol == 0: ChoiceCard {
                        label: "Flow";
                        model: ["нет", "xtls-rprx-vision", "xtls-rprx-vision-udp443"];
                        current-index: root.form.flow;
                        selected(i) => { root.form.flow = i; }
                    }
                    if root.form.protocol == 0: Field {
                        label: "ENCRYPTION (VLESS ENCRYPTION)";
                        placeholder: "none или mlkem768x25519plus.…";
                        mono: true;
                        text: root.form.method;
                        edited(t) => { root.form.method = t; }
                    }
                    if root.form.protocol == 0 && root.form.method != "" && root.form.method != "none": Hint {
                        text: "Постквантовое шифрование Xray (ML-KEM-768 + X25519). Строку encryption выдаёт сервер (xray vlessenc).";
                    }
                    if root.form.protocol == 1: ChoiceCard {
                        label: "Шифрование (security)";
                        model: ["auto", "aes-128-gcm", "chacha20-poly1305", "none", "zero"];
                        current-index: root.form.method-index;
                        selected(i) => {
                            root.form.method-index = i;
                            root.form.method = ["auto", "aes-128-gcm", "chacha20-poly1305", "none", "zero"][i];
                        }
                    }
                    if root.form.protocol == 3: ChoiceCard {
                        label: "Метод шифрования";
                        model: ["aes-128-gcm", "aes-256-gcm", "chacha20-ietf-poly1305", "2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305", "xchacha20-ietf-poly1305", "none"];
                        current-index: root.form.method-index;
                        selected(i) => {
                            root.form.method-index = i;
                            root.form.method = ["aes-128-gcm", "aes-256-gcm", "chacha20-ietf-poly1305", "2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305", "xchacha20-ietf-poly1305", "none"][i];
                        }
                    }
                    if root.form.protocol == 4 || root.form.protocol == 8 || root.form.protocol == 9: Field {
                        label: "ЛОГИН (НЕОБЯЗАТЕЛЬНО)";
                        text: root.form.username;
                        edited(t) => { root.form.username = t; }
                    }
                    if root.form.protocol >= 2 && root.form.protocol != 6 && root.form.protocol != 10: Field {
                        label: "ПАРОЛЬ";
                        text: root.form.uuid;
                        edited(t) => { root.form.uuid = t; }
                    }
                    if root.form.protocol == 10: Field {
                        label: "ПРИВАТНЫЙ КЛЮЧ";
                        mono: true;
                        text: root.form.uuid;
                        edited(t) => { root.form.uuid = t; }
                    }
                    if root.form.protocol == 10: Field {
                        label: "ПУБЛИЧНЫЙ КЛЮЧ СЕРВЕРА";
                        mono: true;
                        text: root.form.public-key;
                        edited(t) => { root.form.public-key = t; }
                    }
                    if root.form.protocol == 10: Field {
                        label: "PRE-SHARED KEY (НЕОБЯЗАТЕЛЬНО)";
                        mono: true;
                        text: root.form.secret;
                        edited(t) => { root.form.secret = t; }
                    }
                    if root.form.protocol == 10: Field {
                        label: "АДРЕСА ИНТЕРФЕЙСА";
                        placeholder: "10.0.0.2/32, fd00::2/128";
                        mono: true;
                        text: root.form.local-address;
                        edited(t) => { root.form.local-address = t; }
                    }
                    if root.form.protocol == 10: Field {
                        label: "RESERVED (ДЛЯ WARP)";
                        placeholder: "0,0,0";
                        mono: true;
                        text: root.form.reserved;
                        edited(t) => { root.form.reserved = t; }
                    }
                    if root.form.protocol == 10: Field {
                        label: "MTU";
                        placeholder: "1280";
                        input-type: InputType.number;
                        mono: true;
                        text: root.form.wg-mtu;
                        edited(t) => { root.form.wg-mtu = t; }
                    }
                    if root.form.protocol == 6: Field {
                        label: "ПАРОЛЬ";
                        text: root.form.secret;
                        edited(t) => { root.form.secret = t; }
                    }
                    if root.form.protocol == 5: ChoiceCard {
                        label: "Обфускация (obfs)";
                        model: ["нет", "salamander"];
                        current-index: root.form.obfs;
                        selected(i) => { root.form.obfs = i; }
                    }
                    if root.form.protocol == 5 && root.form.obfs == 1: Field {
                        label: "ПАРОЛЬ ОБФУСКАЦИИ";
                        text: root.form.obfs-password;
                        edited(t) => { root.form.obfs-password = t; }
                    }
                    if root.form.protocol == 5: Field {
                        label: "ПОРТЫ ДЛЯ PORT HOPPING (НЕОБЯЗАТЕЛЬНО)";
                        placeholder: "20000-30000";
                        mono: true;
                        text: root.form.ports;
                        edited(t) => { root.form.ports = t; }
                    }
                    if root.form.protocol == 6: ChoiceCard {
                        label: "Передача UDP";
                        model: ["native", "quic"];
                        current-index: root.form.udp-mode;
                        selected(i) => { root.form.udp-mode = i; }
                    }
                    if root.form.protocol == 6: ChoiceCard {
                        label: "Управление перегрузкой";
                        model: ["bbr", "cubic", "new_reno"];
                        current-index: root.form.congestion;
                        selected(i) => { root.form.congestion = i; }
                    }

                    if root.form.protocol <= 2: SectionLabel { text: "ТРАНСПОРТ"; }
                    if root.form.protocol <= 2: ChoiceCard {
                        label: "Сеть (network)";
                        model: ["tcp", "ws", "httpupgrade", "grpc", "xhttp"];
                        current-index: root.form.network;
                        selected(i) => { root.form.network = i; }
                    }
                    if root.form.protocol <= 2 && root.form.network == 0: ChoiceCard {
                        label: "Маскировка заголовка (headerType)";
                        model: ["none", "http"];
                        current-index: root.form.header-type == "http" ? 1 : 0;
                        selected(i) => { root.form.header-type = ["", "http"][i]; }
                    }
                    if root.form.protocol <= 2 && root.form.network == 3: ChoiceCard {
                        label: "Режим gRPC";
                        model: ["gun", "multi"];
                        current-index: root.form.header-type == "multi" ? 1 : 0;
                        selected(i) => { root.form.header-type = ["gun", "multi"][i]; }
                    }
                    if root.form.protocol <= 2 && root.form.network == 4: ChoiceCard {
                        label: "Режим XHTTP";
                        model: ["auto", "stream-one", "stream-up", "packet-up"];
                        current-index: root.form.header-type == "stream-one" ? 1 : root.form.header-type == "stream-up" ? 2 : root.form.header-type == "packet-up" ? 3 : 0;
                        selected(i) => { root.form.header-type = ["auto", "stream-one", "stream-up", "packet-up"][i]; }
                    }
                    if root.form.protocol <= 2 && (root.form.network != 0 || root.form.header-type == "http"): Field {
                        label: "HOST";
                        text: root.form.host;
                        edited(t) => { root.form.host = t; }
                    }
                    if root.form.protocol <= 2 && (root.form.network != 0 || root.form.header-type == "http"): Field {
                        label: root.form.network == 3 ? "SERVICENAME" : "PATH";
                        text: root.form.path;
                        edited(t) => { root.form.path = t; }
                    }
                    if root.form.protocol <= 2 || (root.form.protocol >= 5 && root.form.protocol <= 9): SectionLabel { text: "БЕЗОПАСНОСТЬ"; }
                    if root.form.protocol == 8: ChoiceCard {
                        label: "Подключение к прокси";
                        model: ["HTTP", "HTTPS (TLS)"];
                        current-index: root.form.security == 0 ? 0 : 1;
                        selected(i) => { root.form.security = i; }
                    }
                    if root.form.protocol <= 2: ChoiceCard {
                        label: "Security";
                        model: ["none", "tls", "reality"];
                        current-index: root.form.security;
                        selected(i) => { root.form.security = i; }
                    }
                    if (root.form.protocol <= 2 && root.form.security != 0) || ((root.form.protocol >= 5 && root.form.protocol <= 7) || root.form.protocol == 9) || (root.form.protocol == 8 && root.form.security != 0): Field {
                        label: "SNI (SERVERNAME)";
                        text: root.form.sni;
                        edited(t) => { root.form.sni = t; }
                    }
                    if (root.form.protocol <= 2 && root.form.security != 0) || root.form.protocol == 7: Field {
                        label: "FINGERPRINT";
                        placeholder: "chrome";
                        text: root.form.fingerprint;
                        edited(t) => { root.form.fingerprint = t; }
                    }
                    if (root.form.protocol <= 2 && root.form.security != 0) || root.form.protocol == 6 || root.form.protocol == 7: Field {
                        label: "ALPN";
                        placeholder: "h2,http/1.1";
                        text: root.form.alpn;
                        edited(t) => { root.form.alpn = t; }
                    }
                    if (root.form.protocol <= 2 && root.form.security == 1) || ((root.form.protocol >= 5 && root.form.protocol <= 7) || root.form.protocol == 9) || (root.form.protocol == 8 && root.form.security != 0): ToggleCard {
                        text: "Разрешить небезопасный сертификат";
                        hint: "allowInsecure — отключает проверку сертификата";
                        checked: root.form.allow-insecure;
                        toggled(v) => { root.form.allow-insecure = v; }
                    }
                    if (root.form.protocol <= 2 && root.form.security == 1) || ((root.form.protocol >= 5 && root.form.protocol <= 7) || root.form.protocol == 9) || (root.form.protocol == 8 && root.form.security != 0): Field {
                        label: "SHA-256 СЕРТИФИКАТА (PCS)";
                        placeholder: "для самоподписанного сертификата";
                        mono: true;
                        text: root.form.pinned-cert;
                        edited(t) => { root.form.pinned-cert = t; }
                    }
                    if root.form.protocol <= 2 && root.form.security == 2: Field {
                        label: "PUBLICKEY (PBK)";
                        mono: true;
                        text: root.form.public-key;
                        edited(t) => { root.form.public-key = t; }
                    }
                    if root.form.protocol <= 2 && root.form.security == 2: Field {
                        label: "SHORTID (SID)";
                        mono: true;
                        text: root.form.short-id;
                        edited(t) => { root.form.short-id = t; }
                    }
                    if root.form.protocol <= 2 && root.form.security == 2: Field {
                        label: "SPIDERX (SPX)";
                        text: root.form.spider-x;
                        edited(t) => { root.form.spider-x = t; }
                    }
                }
                SaveBar { clicked => { root.form-save(); } }
            }

            // ═══════════════ РЕДАКТОР ПРАВИЛА ═══════════════
            if root.page == "rule": VerticalLayout {
                vertical-stretch: 1;
                SubHeader {
                    title: root.rule-is-new ? "Новое правило" : "Правило";
                    back => { root.open-page("routing"); }
                    if !root.rule-is-new: RoundButton {
                        icon: "delete";
                        tint: Theme.bad;
                        clicked => {
                            root.confirm-text = "Удалить правило?";
                            root.confirm-action = "delete-rule:" + root.rule-form.id;
                            root.confirm-visible = true;
                        }
                    }
                }
                Page {
                    vertical-stretch: 1;
                    side: 24px;
                    gap: 18px;
                    top-pad: 12px;
                    Field { label: "НАЗВАНИЕ"; text: root.rule-form.name; edited(t) => { root.rule-form.name = t; } }
                    ChoiceCard {
                        label: "Действие";
                        model: ["Основной сервер", "Напрямую", "Блок"];
                        current-index: root.rule-form.outbound;
                        selected(i) => { root.rule-form.outbound = i; }
                    }
                    ToggleCard {
                        text: "Правило включено";
                        checked: root.rule-form.enabled;
                        toggled(v) => { root.rule-form.enabled = v; }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        Area {
                            label: "ДОМЕНЫ (ПО ОДНОМУ В СТРОКЕ)";
                            text: root.rule-form.domain;
                            area-height: 130px;
                            edited(t) => { root.rule-form.domain = t; }
                        }
                        Hint { text: "domain:example.com — домен и поддомены; full:a.com — точное совпадение; keyword:ads — подстрока; regexp:… — регулярное выражение; geosite:youtube — категория из geosite.dat."; }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        Area {
                            label: "IP И ПОДСЕТИ (ПО ОДНОМУ В СТРОКЕ)";
                            text: root.rule-form.ip;
                            area-height: 100px;
                            edited(t) => { root.rule-form.ip = t; }
                        }
                        Hint { text: "1.2.3.4, 10.0.0.0/8, 2001:db8::/32, geoip:ru, geoip:private, !geoip:ru — всё, кроме."; }
                    }
                    Field { label: "ПОРТЫ"; placeholder: "443 или 80,443 или 1000-2000"; mono: true; text: root.rule-form.port; edited(t) => { root.rule-form.port = t; } }
                    ChoiceCard {
                        label: "Сеть";
                        model: ["TCP и UDP", "только TCP", "только UDP"];
                        current-index: root.rule-form.network;
                        selected(i) => { root.rule-form.network = i; }
                    }
                    Field { label: "ПРОТОКОЛ (ПО СНИФФИНГУ)"; placeholder: "tls,http"; mono: true; text: root.rule-form.protocol; edited(t) => { root.rule-form.protocol = t; } }
                    if !root.rule-is-new: VerticalLayout {
                        spacing: 8px;
                        SectionLabel { text: "ПОРЯДОК В СПИСКЕ"; }
                        HorizontalLayout {
                            spacing: 8px;
                            for m in [{ icon: "up", text: "Выше", d: -1 }, { icon: "down", text: "Ниже", d: 1 }]: Card {
                                height: 52px;
                                border-radius: 14px;
                                horizontal-stretch: 1;
                                background: mta.pressed ? Theme.surface2 : Theme.surface;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    VerticalLayout { alignment: center; Icon { name: m.icon; size: 16px; stroke-width: 2px; color: Theme.ink2; } }
                                    Text { text: m.text; color: Theme.ink; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                }
                                mta := TouchArea { clicked => { root.rule-move(root.rule-form.id, m.d); } }
                            }
                        }
                    }
                }
                SaveBar { clicked => { root.rule-save(); } }
            }

            // ═══════════════ МАРШРУТ НА ОТДЕЛЬНЫЙ СЕРВЕР ═══════════════
            if root.page == "split": VerticalLayout {
                vertical-stretch: 1;
                SubHeader {
                    title: "Отдельный сервер";
                    back => { root.open-page("routing"); }
                    if !root.split-is-new: RoundButton {
                        icon: "delete";
                        tint: Theme.bad;
                        clicked => {
                            root.confirm-text = "Удалить маршрут «" + root.split-form.name + "»?";
                            root.confirm-action = "delete-split:" + root.split-form.id;
                            root.confirm-visible = true;
                        }
                    }
                }
                Page {
                    vertical-stretch: 1;
                    side: 24px;
                    gap: 18px;
                    top-pad: 12px;
                    Field { label: "НАЗВАНИЕ"; text: root.split-form.name; edited(t) => { root.split-form.name = t; } }
                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { text: "ЧЕРЕЗ КАКОЙ СЕРВЕР"; }
                        Card {
                            height: 60px;
                            border-radius: 14px;
                            background: spt.pressed ? Theme.surface2 : Theme.surface;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                if root.split-server.id != "": ServerText { item: root.split-server; }
                                if root.split-server.id != "": DelayText { item: root.split-server; }
                                if root.split-server.id == "": Text {
                                    text: root.split-servers.length == 0 ? "Сначала добавьте серверы" : "Выберите сервер";
                                    color: Theme.ink2;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout { alignment: center; Chevron { } }
                            }
                            spt := TouchArea {
                                enabled: root.split-servers.length > 0;
                                clicked => { root.sheet = "split-server"; }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        SectionHead {
                            title: "ПРИЛОЖЕНИЯ";
                            note: "выбрано " + root.split-apps-count;
                            note-color: root.split-apps-count > 0 ? Theme.accent : Theme.ink2;
                            side: 0px;
                            pad-top: 0px;
                            pad-bottom: 0px;
                        }
                        SearchBox {
                            text: root.split-filter;
                            edited(t) => { root.split-filter = t; root.split-filter-changed(t); }
                        }
                        VerticalLayout {
                            for a in root.split-apps: AppPick {
                                item: a;
                                toggle(v) => { root.split-app-toggle(a.pkg, v); }
                            }
                            if root.split-apps-more != "": Text {
                                text: root.split-apps-more;
                                color: Theme.ink2;
                                font-size: 12px;
                                height: 36px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        Area {
                            label: "САЙТЫ (ПО ОДНОМУ В СТРОКЕ)";
                            text: root.split-form.domain;
                            area-height: 112px;
                            edited(t) => { root.split-form.domain = t; }
                        }
                        Hint {
                            text: "domain:, full:, keyword:, geosite: — как в обычных правилах. Трафик выбранных приложений или сайтов пойдёт через этот сервер, всё остальное — через основной.";
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { text: "ЕСЛИ СЕРВЕР НЕДОСТУПЕН"; }
                        Segmented {
                            model: ["Блокировать", "Основной сервер"];
                            current: root.split-form.fallback-main ? 1 : 0;
                            selected(i) => { root.split-form.fallback-main = i == 1; }
                        }
                        Hint {
                            text: root.split-form.fallback-main ? "Трафик пойдёт через основной сервер." : "Трафик не пойдёт никуда — без утечек.";
                        }
                    }
                }
                SaveBar { clicked => { root.split-save(); } }
            }

            // ═══════════════ ПРИЛОЖЕНИЯ (VPN) ═══════════════
            if root.page == "apps": VerticalLayout {
                vertical-stretch: 1;
                SubHeader {
                    title: "Прокси для приложений";
                    back => { root.settings-save(); root.open-page("settings"); }
                }
                VerticalLayout {
                    vertical-stretch: 1;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 12px;
                    spacing: 12px;
                    ChoiceCard {
                        label: "Режим";
                        model: ["Выключено — все приложения через VPN", "Только выбранные через VPN", "Выбранные в обход VPN"];
                        current-index: root.apps-mode;
                        selected(i) => { root.apps-mode = i; root.apps-mode-changed(i); }
                    }
                    if root.apps-mode == 0: Hint {
                        x: 8px;
                        text: "Весь трафик устройства идёт через VPN (кроме самого XrayDroid). Выберите режим, чтобы указать отдельные приложения.";
                    }
                    if root.apps-mode != 0: HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 48px;
                            SearchBox {
                                text: root.apps-filter;
                                edited(t) => { root.apps-filter = t; root.apps-filter-changed(t); }
                            }
                        }
                        TextButton { text: "Все"; tint: Theme.accent; height: 48px; clicked => { root.apps-select-all(true); } }
                        TextButton { text: "Сброс"; tint: Theme.ink2; height: 48px; clicked => { root.apps-select-all(false); } }
                    }
                    if root.apps-mode != 0 && root.apps-loading: Text {
                        text: "Загрузка списка приложений…";
                        color: Theme.ink2;
                        horizontal-alignment: center;
                    }
                    if root.apps-mode != 0 && !root.apps-loading: Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        Flickable {
                            content-height: al.preferred-height + 16px;
                            al := VerticalLayout {
                                width: parent.width;
                                for a in root.apps: AppPick {
                                    item: a;
                                    toggle(v) => { root.app-toggle(a.pkg, v); }
                                }
                                if root.apps-more != "": Text {
                                    text: root.apps-more;
                                    color: Theme.ink2;
                                    font-size: 12px;
                                    height: 40px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // ═══════════════ ДОПОЛНИТЕЛЬНО ═══════════════
            if root.page == "advanced": VerticalLayout {
                vertical-stretch: 1;
                SubHeader {
                    title: "Дополнительно";
                    back => { root.settings-save(); root.open-page("settings"); }
                }
                Page {
                    vertical-stretch: 1;
                    side: 24px;
                    gap: 18px;
                    top-pad: 12px;
                    bottom-pad: 32px;
                    ToggleCard {
                        text: "allowInsecure по умолчанию";
                        hint: "для новых TLS-профилей";
                        checked: root.settings.allow-insecure;
                        toggled(v) => { root.settings.allow-insecure = v; root.settings-save(); }
                    }
                    Field { label: "ПОРТ ЛОКАЛЬНОГО SOCKS5"; input-type: InputType.number; mono: true; text: root.settings.socks-port; edited(t) => { root.settings.socks-port = t; } }
                    Field { label: "DNS-СЕРВЕР ДЛЯ ПРОЧИХ ЗАПРОСОВ"; mono: true; text: root.settings.dns; edited(t) => { root.settings.dns = t; } }
                    Field { label: "MTU"; input-type: InputType.number; mono: true; text: root.settings.mtu; edited(t) => { root.settings.mtu = t; } }
                    Field { label: "URL ДЛЯ ТЕСТА ЗАДЕРЖКИ"; mono: true; text: root.settings.test-url; edited(t) => { root.settings.test-url = t; } }
                    Field { label: "USER-AGENT ДЛЯ ПОДПИСОК"; mono: true; text: root.settings.ua; edited(t) => { root.settings.ua = t; } }
                    Hint { text: "Изменения применятся при следующем подключении."; }
                }
            }

            // ═══════════════ ЖУРНАЛ ═══════════════
            if root.page == "logs": VerticalLayout {
                vertical-stretch: 1;
                SubHeader {
                    title: "Журнал";
                    back => { root.open-page("settings"); }
                    RoundButton { icon: "copy"; clicked => { root.logs-copy(); } }
                    RoundButton { icon: "refresh"; clicked => { root.logs-refresh(); } }
                    RoundButton { icon: "delete"; tint: Theme.bad; clicked => { root.logs-clear(); } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    ScrollView {
                        for l in root.logs: Text {
                            text: l;
                            color: Theme.ink;
                            font-size: 11px;
                            font-family: Theme.mono;
                            wrap: word-wrap;
                            x: 24px;
                            width: parent.width - 48px;
                        }
                    }
                }
            }

            // ═══════════════ О ПРОГРАММЕ ═══════════════
            if root.page == "about": VerticalLayout {
                vertical-stretch: 1;
                SubHeader {
                    title: "О программе";
                    back => { root.open-page("settings"); }
                }
                Page {
                    vertical-stretch: 1;
                    side: 24px;
                    gap: 18px;
                    bottom-pad: 32px;
                    VerticalLayout {
                        padding-top: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 84px;
                                height: 84px;
                                border-radius: 42px;
                                background: Theme.surface;
                                Icon { name: "logo"; size: 36px; color: Theme.accent; stroke-width: 2.5px; }
                            }
                        }
                        Text {
                            text: "XrayDroid " + root.version;
                            color: Theme.ink;
                            font-size: 20px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Hint {
                            text: "VPN-клиент для Android в стиле v2rayN/v2rayNG. Ядро и интерфейс написаны на Rust.";
                            horizontal-alignment: center;
                        }
                    }
                    Card {
                        height: ab.preferred-height;
                        ab := VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            SectionLabel { text: "ПОДДЕРЖИВАЕТСЯ"; }
                            Text { color: Theme.ink; font-size: 14px; wrap: word-wrap; text: "• VLESS (XTLS Vision, VLESS Encryption, XUDP), VMess AEAD, Trojan, Shadowsocks (AEAD, 2022), Hysteria2 (+Salamander), TUIC v5, AnyTLS, SOCKS5, HTTP(S)"; }
                            Text { color: Theme.ink; font-size: 14px; wrap: word-wrap; text: "• TCP (+HTTP-маскировка), TLS, REALITY, WebSocket, HTTPUpgrade, gRPC, XHTTP"; }
                            Text { color: Theme.ink; font-size: 14px; wrap: word-wrap; text: "• Маршрутизация: домены, IP, geosite/geoip, порты, протоколы, отдельные серверы для приложений и сайтов"; }
                            Text { color: Theme.ink; font-size: 14px; wrap: word-wrap; text: "• Подписки, тест задержки, FakeDNS, раздельное туннелирование"; }
                        }
                    }
                    Hint { text: "Лицензия GPL-3.0."; horizontal-alignment: center; }
                }
            }

            // ═══════════════ НИЖНЯЯ ПАНЕЛЬ ═══════════════
            if root.is-tab() && root.kb <= 0: NavBar {
                inset: root.bottom-inset;
                current: root.page;
                open(id) => { root.show-tab(id); }
            }
        }
    }

    // ── листы ──
    if root.sheet == "server": SheetFrame {
        dismiss => { root.sheet = ""; }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 20px;
            padding-bottom: 16px;
            spacing: 14px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                Text {
                    text: root.sheet-server.name;
                    color: Theme.ink;
                    font-size: 20px;
                    font-weight: 600;
                    letter-spacing: -0.2px;
                    overflow: elide;
                }
                Text { text: root.sheet-server.kind; color: Theme.ink2; font-size: 13px; overflow: elide; }
            }
            VerticalLayout {
                alignment: center;
                Badge {
                    text: root.sheet-server.delay;
                    font-size: 13px;
                    pad-y: 6px;
                    ink: root.sheet-server.delay-state == 2 ? Theme.warn : root.sheet-server.delay-state == 3 ? Theme.bad : Theme.ink;
                }
            }
        }
        // выбранный и уже работающий сервер можно только отключить
        PrimaryButton {
            property <bool> active: root.sheet-server.selected && (root.running || root.connecting);
            text: self.active ? "Отключиться" : "Подключиться";
            clicked => {
                root.sheet = "";
                if (self.active) {
                    root.toggle-vpn();
                } else {
                    root.connect-server(root.sheet-server.id);
                }
            }
        }
        Rectangle { height: 12px; }
        SheetItem { text: "Проверить задержку"; icon: "gauge"; clicked => { root.sheet = ""; root.test-server(root.sheet-server.id); } }
        SheetItem { text: "Изменить"; icon: "edit"; clicked => { root.sheet = ""; root.edit-server(root.sheet-server.id); } }
        SheetItem { text: "Поделиться ссылкой"; icon: "share"; clicked => { root.sheet = ""; root.share-server(root.sheet-server.id); } }
        SheetDivider { }
        SheetItem {
            text: "Удалить";
            icon: "delete";
            danger: true;
            clicked => {
                root.sheet = "";
                root.confirm-text = "Удалить сервер «" + root.sheet-server.name + "»?";
                root.confirm-action = "delete-server:" + root.sheet-server.id;
                root.confirm-visible = true;
            }
        }
        Rectangle { height: root.bottom-inset; }
    }

    // выбор сервера для маршрута
    if root.sheet == "split-server": SheetFrame {
        title: "Через какой сервер";
        dismiss => { root.sheet = ""; }
        for s in root.split-servers: ServerPick {
            item: s;
            pick => {
                root.split-pick-server(s.id);
                root.sheet = "";
            }
        }
        Rectangle { height: root.bottom-inset; }
    }

    if root.sheet == "add": SheetFrame {
        title: "Добавить";
        dismiss => { root.sheet = ""; }
        SheetItem { text: "Импорт из буфера обмена"; icon: "paste"; clicked => { root.sheet = ""; root.import-clipboard(); } }
        SheetItem { text: "Вставить ссылки вручную"; icon: "edit"; clicked => { root.sheet = ""; root.paste-text = ""; root.paste-visible = true; } }
        SheetItem { text: "Добавить подписку"; icon: "layers"; clicked => { root.sheet = ""; root.sub-new(); } }
        SheetItem { text: "Создать пустую группу"; icon: "layers"; clicked => { root.sheet = ""; root.group-new(); } }
        SheetItem {
            text: "Создать сервер вручную";
            icon: "plus";
            clicked => {
                root.sheet = "";
                Picker.title = "Тип сервера";
                Picker.items = ["VLESS", "VMess", "Trojan", "Shadowsocks", "SOCKS", "Hysteria2", "TUIC", "AnyTLS", "HTTP-прокси", "NaiveProxy", "WireGuard"];
                Picker.current = -1;
                Picker.owner = "new-server";
                Picker.visible = true;
            }
        }
        SheetDivider { }
        SheetItem { text: "Сортировать по задержке"; icon: "sort"; clicked => { root.sheet = ""; root.menu-action("sort"); } }
        SheetItem { text: "Обновить подписки"; icon: "refresh"; clicked => { root.sheet = ""; root.menu-action("update-subs"); } }
        SheetItem { text: "Экспорт группы в буфер"; icon: "copy"; clicked => { root.sheet = ""; root.menu-action("export"); } }
        SheetItem { text: "Удалить дубликаты"; icon: "delete"; clicked => { root.sheet = ""; root.menu-action("dedup"); } }
        SheetItem { text: "Удалить недоступные"; icon: "delete"; clicked => { root.sheet = ""; root.menu-action("remove-bad"); } }
        SheetItem {
            text: "Удалить все в группе";
            icon: "delete";
            danger: true;
            clicked => {
                root.sheet = "";
                root.confirm-text = "Удалить все серверы в этой группе?";
                root.confirm-action = "delete-group";
                root.confirm-visible = true;
            }
        }
        Rectangle { height: root.bottom-inset; }
    }

    // выбор из списка
    if Picker.visible: SheetFrame {
        title: Picker.title;
        dismiss => { Picker.visible = false; }
        Flickable {
            height: min(Picker.items.length * 52px, 416px);
            content-height: Picker.items.length * 52px;
            VerticalLayout {
                width: parent.width;
                for item[i] in Picker.items: Rectangle {
                    height: 52px;
                    border-radius: 12px;
                    background: pta.pressed ? Theme.ink.with-alpha(0.05) : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 14px;
                        VerticalLayout { alignment: center; Radio { on: i == Picker.current; } }
                        Text {
                            text: item;
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    pta := TouchArea {
                        clicked => {
                            Picker.result = i;
                            Picker.serial += 1;
                            Picker.visible = false;
                        }
                    }
                }
            }
        }
        Rectangle { height: root.bottom-inset; }
    }

    // ── диалог подтверждения ──
    if root.confirm-visible: DialogFrame {
        title: root.confirm-text;
        dismiss => { root.confirm-visible = false; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            TextButton { text: "Отмена"; tint: Theme.ink2; clicked => { root.confirm-visible = false; } }
            TextButton {
                text: "OK";
                tint: Theme.accent;
                clicked => {
                    root.confirm-visible = false;
                    root.confirm-ok(root.confirm-action);
                }
            }
        }
    }

    // ── предложение обновиться ──
    if root.update-dialog: DialogFrame {
        title: "Доступна новая версия " + root.update-version;
        dismiss => { root.update-dialog = false; }
        Hint {
            font-size: 14px;
            text: "Обновить сейчас? Приложение скачает обновление, установит его и перезапустится само."
                + (root.running ? " VPN подключится заново автоматически." : "");
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            TextButton { text: "Позже"; tint: Theme.ink2; clicked => { root.update-dialog = false; } }
            TextButton {
                text: "Да";
                tint: Theme.accent;
                clicked => {
                    root.update-dialog = false;
                    root.update-start();
                    // ход загрузки виден в настройках
                    root.sheet = "";
                    root.show-tab("settings");
                }
            }
        }
    }

    // ── вставка ссылок вручную ──
    if root.paste-visible: DialogFrame {
        title: "Вставьте ссылки";
        dismiss => { root.paste-visible = false; }
        Area {
            text: root.paste-text;
            area-height: 150px;
            edited(t) => { root.paste-text = t; }
        }
        Hint { text: "Одна или несколько ссылок vless:// vmess:// trojan:// ss:// socks:// или содержимое подписки в base64."; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            TextButton { text: "Отмена"; tint: Theme.ink2; clicked => { root.paste-visible = false; } }
            TextButton {
                text: "Импорт";
                tint: Theme.accent;
                clicked => {
                    root.paste-visible = false;
                    root.import-text(root.paste-text);
                }
            }
        }
    }

    // ── диалог подписки ──
    if root.sub-dialog: DialogFrame {
        title: root.sub-group ? (root.sub-id == "" ? "Новая группа" : "Группа") : (root.sub-id == "" ? "Новая подписка" : "Подписка");
        dismiss => { root.sub-dialog = false; }
        Field { label: "НАЗВАНИЕ"; text: root.sub-name; edited(t) => { root.sub-name = t; } }
        if !root.sub-group: Field { label: "URL"; placeholder: "https://…"; mono: true; text: root.sub-url; edited(t) => { root.sub-url = t; } }
        Hint {
            text: root.sub-group
                ? "Пустая вкладка на главном экране без загрузки подписки. Серверы, добавленные через «+», пока открыта эта вкладка, попадут в неё."
                : "Название можно не указывать — оно подтянется из подписки. Без URL будет создана пустая группа. Серверы появятся отдельной вкладкой на главном экране.";
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if root.sub-id != "": TextButton {
                text: "Удалить";
                tint: Theme.bad;
                clicked => {
                    root.sub-dialog = false;
                    root.confirm-text = (root.sub-group ? "Удалить группу «" : "Удалить подписку «") + root.sub-name + "» и её серверы?";
                    root.confirm-action = "delete-sub:" + root.sub-id;
                    root.confirm-visible = true;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            TextButton { text: "Отмена"; tint: Theme.ink2; clicked => { root.sub-dialog = false; } }
            TextButton {
                text: "Сохранить";
                tint: Theme.accent;
                clicked => {
                    root.sub-dialog = false;
                    root.sub-save();
                }
            }
        }
    }

    // ── всплывающее уведомление ──
    Rectangle {
        x: 24px;
        width: root.width - 48px;
        height: toast-t.preferred-height + 24px;
        y: root.height - max(root.bottom-inset, root.kb) - self.height - (root.is-tab() ? 100px : 24px);
        border-radius: 14px;
        background: Theme.toast;
        opacity: root.toast-visible ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 200ms; }
        toast-t := Text {
            x: 16px;
            width: parent.width - 32px;
            text: root.toast-text;
            color: #f2f3f0;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}
